### LOAD MODEL AND DATA ###
reset;

model csp_benders2.mod;
data ../examples/small.ampl;  # Replace with your actual data file name

### SOLVER OPTIONS ###
option solver cplex;      # You can also use 'gurobi' or 'glpk'
option display_precision 6;
option solve_messages 0;  # Set to 1 to see solver output for every subproblem

### INITIALIZATION ###


let nCUT := 0;
param violation_found binary default 0;
param iteration default 0;
param epsilon := 1e-7;
param current_dual_val;
suffix unbdd OUT;

set cut_types{1..2} := {-1, 1};
# -1 for lower protection, 1 for upper protection

problem Master:
    y,
    Total_Cost,
    Primary_Must_Be_Suppressed,
    ProtectionCut;
    
problem Dual_Problem:
    LAMBDA,
    GAMMA,
    MU_L,
    MU_U,
    Dual_Objective_Function,
    Dual_Restriction;
    
printf "\nStarting Benders Decomposition for CSP\n";
printf "========================================\n";

repeat {
    let iteration := iteration + 1;
    let violation_found := 0;
	#if iteration > 5 then break; #debug show only 2 iterations
	
    # 1. SOLVE MASTER PROBLEM (Slide 75, Step 2)
    printf "\nIteration %d: Solving Master Problem... \n", iteration;
    solve Master;
    printf "Cost: %.2f\n", Total_Cost;
	
    # Fix the current suppression pattern for the subproblems
    for {i in CELLS} {
        let y_fixed[i] := y[i];
        printf "%d ", y[i];
    }
    printf "\n";

    # 2. SUBPROBLEM LOOP
	for {i in 1..2, cut_type in cut_types[i]} {
    	# Check every primary cell p for both Lower and Upper protection
	    for {j in P_INDEX} {
	        let p_index := p[j];
	        let L_or_U  := cut_type;
	        let PROTECTION_LVL := if cut_type == 1 then pupl[j] else plpl[j];
	        
	        printf "\n primary cell %d \n", p_index;
	
	        # --- A. Check Lower Protection (Slide 76-77) ---
	        solve Dual_Problem;
	        if Dual_Problem.result = "unbounded" then {          
	            let nCUT := nCUT + 1;
	            let gamma[nCUT] := GAMMA.unbdd;
                let {ii in CELLS} mu_l[ii, nCUT] := MU_L[ii].unbdd;
                let {ii in CELLS} mu_u[ii, nCUT] := MU_U[ii].unbdd;
	            let protection_lvl[nCUT] := PROTECTION_LVL;
	            
	            let violation_found := 1;
	            
	            if cut_type == 1 then {
					printf "Added a cut for upper protection in primary cell %d\n", p[j];
				}
				else {
					printf "Added a cut for lower protection in primary cell %d\n", p[j];
				}
			}
	    }
    }
    # 3. CONVERGENCE CHECK (Slide 79, Step 5)
    # If no new constraints were added to J, the solution is optimal.
    if violation_found = 0 then {
        printf "\nConvergence reached! No violations found.\n";
        break;
    }
}; #while {violation_found > 0};

### FINAL RESULTS ###
printf "\n========================================\n";
printf "Benders Finished in %d iterations\n", iteration;
printf "Total Cuts: %d\n", nCUT;
printf "Final Suppression Cost: %.2f\n", Total_Cost;

printf "\nSuppressed Cells (y_i=1):\n";
printf "%-10s | %-10s | %-10s\n", "Cell ID", "Cost", "Is Primary";
for {i in CELLS: y[i] > 0.5} {
    printf "%-10d | %-10d | %-10d\n", i, c[i], is_p[i];
}
printf "========================================\n";